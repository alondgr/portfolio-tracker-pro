generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String   
  symbol      String
  quantity    Float
  type        String   @default("BUY")
  avgBuyPrice Float
  date        String
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([symbol])
}
