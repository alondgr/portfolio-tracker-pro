generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  symbol      String
  quantity    Float
  avgBuyPrice Float
  date        String
  createdAt   DateTime @default(now())
  type        String   @default("BUY")

  @@index([userId])
  @@index([symbol])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  symbol    String
  isStarred Boolean  @default(false)
  addedPrice Float?
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
  @@index([userId])
}

model SystemHealthLog {
  id        String   @id @default(uuid())
  level     String   // 'ERROR', 'WARN', 'INFO'
  category  String   // 'API', 'DATABASE', 'RUNTIME', 'TYPE_MISMATCH'
  message   String
  metadata  Json?    
  createdAt DateTime @default(now())
  resolved  Boolean  @default(false)
}
